# setup for duckdb testing
#
db_path=H:\tpcds\tpcds_sf10.db

CACHE_QUERIES=H:\tpcds\quack\tpcds_queries.sql
SQL_FILE_PATH=H:\tpcds\quack\cache_queries.sql

QUACK_HOST=localhost
QUACK_PORT=9494
QUACK_TOKEN=super_secret

#
# Recommended .env when 2 clients share one machine
#
AUTO_THREADS=true
RESERVED_CORES=2          # leave 4 cores for the other client
MEMORY_FRACTION=0.35      # each client gets ~35% of RAM
WORKER_THREADS=2
OOM_RETRIES=2
OOM_BACKOFF_SEC=2.0
#
# End of muti-client settings

MEMORY_LIMIT=24GB
# PHYSICAL_CORES=4
# QUERY_THREADS=3
# WORKER_THREADS=2

PRESERVE_INSERTION_ORDER=false

# full | arrow | drain
RESULT_MODE=full

CHART_FORMAT=jpg

RESULTS_DIR=H:\tpcds\quack\results

N_QUERIES=99
N_REPEAT=1
N_WORKERS=1
MODE=local_inprocess